# Browser REST requests always use /api/v1 on the frontend origin.
# Next.js forwards them to NestJS using this server-side proxy target.
# Set this to the backend public (or internal) HTTPS API URL in production.
API_PROXY_TARGET=http://localhost:8800/api/v1

# Public URL for the separate Socket.IO endpoint (also used as API proxy fallback).
NEXT_PUBLIC_API_URL=http://localhost:8800/api/v1
# Set when websocket host differs from NEXT_PUBLIC_API_URL.
# NEXT_PUBLIC_SOCKET_URL=http://localhost:8800
