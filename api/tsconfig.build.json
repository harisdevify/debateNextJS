{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Keep the incremental cache INSIDE dist: Nest deletes dist on every
    // build/start (deleteOutDir), so the cache must go with it. A cache left
    // outside dist makes tsc think everything is already emitted -> empty dist.
    "tsBuildInfoFile": "./dist/tsconfig.build.tsbuildinfo"
  },
  "exclude": ["node_modules", "test", "dist", "**/*spec.ts"]
}
