# NestJS API
PORT=8800
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Generate a unique secret for your local environment; never commit .env
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# PostgreSQL connection string (this value matches `docker compose up -d` at the repo root)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/debate?schema=public

# Optional coturn REST authentication. Configure BOTH, only on the API.
# TURN_URLS=turn:relay.example.com:3478,turns:relay.example.com:5349
# TURN_SECRET=your-coturn-static-auth-secret
