generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ReportReason {
  HARASSMENT
  ABUSIVE_LANGUAGE
  INAPPROPRIATE_CONTENT
  SPAM
  OTHER
}

enum ReportStatus {
  OPEN
  REVIEWED
}

enum UserRole {
  USER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum ModerationKind {
  DISMISS
  WARN
  SUSPEND
  BAN
  RESTORE
}

model User {
  role UserRole @default(USER)
  status AccountStatus @default(ACTIVE)
  suspendedUntil DateTime? @map("suspended_until") @db.Timestamptz()
  moderationReceived ModerationAction[] @relation("ModerationTarget")
  moderationPerformed ModerationAction[] @relation("ModerationActor")
  id        Int      @id @default(autoincrement())
  fullname  String   @db.VarChar(100)
  email     String   @unique @db.VarChar(150)
  gender    String   @db.VarChar(20)
  education String   @db.VarChar(100)
  country   String   @db.VarChar(100)
  password  String   @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)

  // set when the user accepted the rules / confirmed they are 18+
  acceptedRulesAt DateTime? @map("accepted_rules_at") @db.Timestamp(0)
  ageConfirmedAt  DateTime? @map("age_confirmed_at") @db.Timestamp(0)

  reportsMade    Report[] @relation("ReportReporter")
  reportsAgainst Report[] @relation("ReportReported")
  blocksMade     Block[]  @relation("Blocker")
  blocksReceived Block[]  @relation("Blocked")
  revokedTokens   RevokedToken[]
  historyAsFirst  DebateHistory[] @relation("HistoryFirstUser")
  historyAsSecond DebateHistory[] @relation("HistorySecondUser")
  feedbackGiven DebateFeedback[] @relation("FeedbackRater")
  feedbackReceived DebateFeedback[] @relation("FeedbackRecipient")

  @@map("debate_users")
}

// Reports are only stored for now; review and strikes/bans come later.
model Report {
  moderationActions ModerationAction[]
  id             Int          @id @default(autoincrement())
  reporterId     Int          @map("reporter_id")
  reportedUserId Int          @map("reported_user_id")
  reason         ReportReason
  details        String?      @db.VarChar(500)
  status         ReportStatus @default(OPEN)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamp(0)

  reporter     User @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser User @relation("ReportReported", fields: [reportedUserId], references: [id], onDelete: Cascade)

  @@index([reporterId, createdAt])
  @@index([reportedUserId])
  @@index([status, createdAt])
  @@map("reports")
}

// A user never gets matched with someone they blocked (or who blocked them).
model Block {
  blockerId Int      @map("blocker_id")
  blockedId Int      @map("blocked_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
  @@map("blocks")
}

model RateLimit {
  key       String   @id
  count     Int
  expiresAt DateTime @map("expires_at") @db.Timestamptz()
  @@index([expiresAt])
  @@map("rate_limits")
}

model ModerationAction {
  id Int @id @default(autoincrement())
  actorId Int @map("actor_id")
  targetId Int @map("target_id")
  reportId Int? @map("report_id")
  kind ModerationKind
  reason String @db.VarChar(1000)
  suspendedUntil DateTime? @map("suspended_until") @db.Timestamptz()
  previousStatus AccountStatus @map("previous_status")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  actor User @relation("ModerationActor", fields: [actorId], references: [id], onDelete: Restrict)
  target User @relation("ModerationTarget", fields: [targetId], references: [id], onDelete: Restrict)
  report Report? @relation(fields: [reportId], references: [id], onDelete: Restrict)
  @@index([targetId, createdAt])
  @@index([reportId])
  @@map("moderation_actions")
}

// A revoked login token remains invalid until its original JWT expiration.
model RevokedToken {
  tokenHash String @id @map("token_hash") @db.VarChar(64)
  userId Int @map("user_id")
  expiresAt DateTime @map("expires_at") @db.Timestamptz()
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("revoked_tokens")
}

// Stores only server-observed session metadata: NEVER chat, call audio/video,
// partner identities in API responses, SDP or ICE candidates.
enum DebateEndReason {
  COMPLETED
  ENDED
}

model DebateHistory {
  id           String          @id @db.Uuid
  firstUserId  Int             @map("first_user_id")
  secondUserId Int             @map("second_user_id")
  topic        String          @db.VarChar(40)
  language     String          @db.VarChar(5)
  mode         String          @db.VarChar(20)
  startedAt    DateTime        @map("started_at") @db.Timestamptz()
  endedAt      DateTime        @map("ended_at") @db.Timestamptz()
  endReason    DebateEndReason @map("end_reason")
  firstUser    User            @relation("HistoryFirstUser", fields: [firstUserId], references: [id], onDelete: Cascade)
  secondUser   User            @relation("HistorySecondUser", fields: [secondUserId], references: [id], onDelete: Cascade)
  feedbacks    DebateFeedback[]

  @@index([firstUserId, endedAt(sort: Desc)])
  @@index([secondUserId, endedAt(sort: Desc)])
  @@map("debate_history")
}

// Feedback is private: only the rater can view their own submitted rating.
// Recipient is inferred server-side from the ended debate, never trusted from a request.
model DebateFeedback {
  id        Int      @id @default(autoincrement())
  debateId  String   @map("debate_id") @db.Uuid
  raterId   Int      @map("rater_id")
  recipientId Int    @map("recipient_id")
  rating    Int      @db.SmallInt
  comment   String?  @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  debate    DebateHistory @relation(fields: [debateId], references: [id], onDelete: Cascade)
  rater     User @relation("FeedbackRater", fields: [raterId], references: [id], onDelete: Cascade)
  recipient User @relation("FeedbackRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([debateId, raterId])
  @@index([recipientId, createdAt])
  @@map("debate_feedback")
}
